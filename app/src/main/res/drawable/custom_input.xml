<?xml version="1.0" encoding="utf-8"?>
<!--
  custom_input
  Background for EditText / TextInputLayout fields.
  Rounded rectangle with a 1dp stroke in the primary colour.
  Fill uses l_windowBackground (#ffffff) so it stands out from the beige page bg.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/l_windowBackground" />
    <stroke
        android:width="1dp"
        android:color="@color/l_colorPrimary" />
    <corners android:radius="8dp" />
</shape>
