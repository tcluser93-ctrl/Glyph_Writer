<?xml version="1.0" encoding="utf-8"?>
<!--
  custom_input
  Background for EditText / TextInputLayout fields.
  Rounded rectangle with a 1dp stroke in the primary colour and a very
  subtle surface fill so the field is distinguishable from the page bg.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/l_background" />
    <stroke
        android:width="1dp"
        android:color="@color/colorPrimary" />
    <corners android:radius="8dp" />
</shape>
