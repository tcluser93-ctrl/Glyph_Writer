<?xml version="1.0" encoding="utf-8"?>
<!--
  image_bar_text
  Semi-transparent dark bar used as a text overlay on images
  (e.g. caption strip at the bottom of an ImageView).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/l_backgroundDark" />
    <corners android:radius="4dp" />
</shape>
