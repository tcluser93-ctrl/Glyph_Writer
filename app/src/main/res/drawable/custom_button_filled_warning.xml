<?xml version="1.0" encoding="utf-8"?>
<!--
  custom_button_filled_warning
  Solid warning/destructive-colour fill.  Used for delete / irreversible actions.
  Falls back to Material deep-orange (#FF5722) if colorWarning is not defined.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/l_ripple_dark">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorWarning" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>
