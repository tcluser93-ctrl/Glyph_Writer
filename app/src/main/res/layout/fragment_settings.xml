<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/l_windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Titolo sezione Aspetto -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_appearance"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/l_colorPrimaryDark"
            android:paddingBottom="8dp"
            android:paddingTop="4dp" />

        <!-- E-05: Toggle tema dark -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_dark_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_dark_theme_label"
            android:textColor="@color/l_textColor"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:thumbTint="@color/l_colorPrimaryDark"
            app:trackTint="@color/l_colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_dark_theme_desc"
            android:textSize="12sp"
            android:textColor="@color/l_textColorPrimary"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/l_backgroundDarker"
            android:layout_marginBottom="16dp" />

        <!-- Titolo sezione Accessibilità -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_accessibility"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/l_colorPrimaryDark"
            android:paddingBottom="8dp"
            android:paddingTop="4dp" />

        <!-- E-06: Toggle haptic CAA -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_haptic_caa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_haptic_caa_label"
            android:textColor="@color/l_textColor"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:thumbTint="@color/l_colorPrimaryDark"
            app:trackTint="@color/l_colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_haptic_caa_desc"
            android:textSize="12sp"
            android:textColor="@color/l_textColorPrimary"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/l_backgroundDarker"
            android:layout_marginBottom="16dp" />

        <!-- ─────────────────────────────────────────────────────────────── -->
        <!-- Titolo sezione Lingua di traduzione (audit EG, 2026-07-22) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_language"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/l_colorPrimaryDark"
            android:paddingBottom="8dp"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_bliss_lang_label"
            android:textColor="@color/l_textColor"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <!-- Exposed Dropdown Menu Material3: sola selezione, nessun input libero.
             Popolata in SettingsFragment con "Segui lingua di sistema" +
             le 8 lingue in BlissLookup.SUPPORTED_LANGS (nome nella lingua stessa). -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_bliss_lang"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdown_bliss_lang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:contentDescription="@string/settings_bliss_lang_label" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_bliss_lang_desc"
            android:textSize="12sp"
            android:textColor="@color/l_textColorPrimary"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/l_backgroundDarker"
            android:layout_marginBottom="16dp" />

        <!-- ─────────────────────────────────────────────────────────────── -->
        <!-- Titolo sezione Vista Bliss (C-05) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_bliss_view"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/l_colorPrimaryDark"
            android:paddingBottom="8dp"
            android:paddingTop="4dp" />

        <!-- C-05: Numero card Bliss per riga -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_bliss_cards_per_row_label"
            android:textColor="@color/l_textColor"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <!-- Slider Material 3: valueFrom=2, valueTo=8, stepSize=1, default letto da AppPreferences -->
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_bliss_cards_per_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="2"
            android:valueTo="8"
            android:stepSize="1"
            android:value="4"
            android:contentDescription="@string/settings_bliss_cards_per_row_label"
            app:thumbColor="@color/l_colorPrimaryDark"
            app:trackColorActive="@color/l_colorPrimary"
            app:trackColorInactive="@color/l_backgroundDarker"
            app:labelBehavior="floating" />

        <TextView
            android:id="@+id/tv_bliss_cards_per_row_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_bliss_cards_per_row_desc"
            android:textSize="12sp"
            android:textColor="@color/l_textColorPrimary"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_bliss_cards_per_row_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4"
            android:textSize="12sp"
            android:textColor="@color/l_colorPrimaryDark"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

    </LinearLayout>
</ScrollView>
