<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_bliss_translate.xml
    Layout root del BlissTranslateFragment.

    View-binding genera: FragmentBlissTranslateBinding
    View ID usati dal fragment (tutti obbligatori per la compilazione):

      etInput               — TextInputEditText (input testo)
      btnTranslate          — MaterialButton (trigger manuale)
      btnClear              — MaterialButton (svuota input)
      toggleGroup           — MaterialButtonToggleGroup (CHIPS / CARDS / MIXED)
        btnViewChips        — MaterialButton toggle
        btnViewCards        — MaterialButton toggle
        btnViewMixed        — MaterialButton toggle
      progressBar           — ProgressBar
      tvEmpty               — TextView empty-state
      chipScroll            — HorizontalScrollView (wrapper chipGroup)
        chipGroup           — ChipGroup
      rvCards               — RecyclerView (card CAA)
      mixedPreviewContainer — FrameLayout (wrapper MixedBlissRowView)
        mixedPreview        — com.blueapps.egyptianwriter.bliss.MixedBlissRowView
      tilDebugLog           — TextInputLayout  (pannello log debug)
        etDebugLog          — TextInputEditText (log visibile a schermo)
      fabShare              — FloatingActionButton
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".bliss.BlissTranslateFragment">

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="88dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── B-01: Input testo ─────────────────────────────────── -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bliss_input_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:maxLines="5"
                    android:imeOptions="actionDone"
                    android:contentDescription="@string/bliss_input_hint" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── B-02: Pulsanti traduzione / cancella ──────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/bliss_btn_clear"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bliss_btn_translate" />

            </LinearLayout>

            <!-- ── Toggle CHIPS / CARDS / MIXED ─────────────────────── -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bliss_view_chips"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewCards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bliss_view_cards"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bliss_view_mixed"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ── Progress + empty state ─────────────────────────────── -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/bliss_empty_state"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ── C-01: Vista Chip ───────────────────────────────────── -->
            <HorizontalScrollView
                android:id="@+id/chipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:visibility="visible">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />

            </HorizontalScrollView>

            <!-- ── C-02: Vista Card CAA ──────────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:listitem="@layout/item_symbol_card" />

            <!-- ── N-01: Vista Mixed preview ─────────────────────────── -->
            <FrameLayout
                android:id="@+id/mixedPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.blueapps.egyptianwriter.bliss.MixedBlissRowView
                    android:id="@+id/mixedPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </FrameLayout>

            <!-- ── DEBUG LOG: pannello debug visibile a schermo ─────── -->
            <!-- Rimuovere o impostare visibility="gone" in produzione.    -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDebugLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Debug log Bliss"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDebugLog"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="5"
                    android:maxLines="10"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="vertical"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:contentDescription="Debug log del flusso di traduzione Bliss" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── D-01: FAB Share ──────────────────────────────────────────── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/bliss_fab_share_desc"
        app:srcCompat="@android:drawable/ic_menu_share"
        app:layout_anchor="@id/fabShare"
        app:layout_anchorGravity="bottom|end" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
