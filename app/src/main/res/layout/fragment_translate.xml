<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_translate.xml
  Layout per BlissTranslateFragment — Patch 12 (2026-07-10).

  Novità Patch 12 rispetto al Blocco C:
  - Aggiunto MixedBlissRowView (@id/mixed_bliss_row_view) dopo symbol_container
    per il rendering misto testo+SVG in modalità standard multi-token.

  View IDs usati da BlissTranslateFragment.bindViews():
    spinner_language, input_layout_text, edit_input_text,
    label_suggestions, rv_suggestions, btn_translate,
    progress_translate, text_output_label, text_output,
    label_symbols, symbol_container, mixed_bliss_row_view,
    fab_share, switch_caa_mode,
    caa_container, rv_caa_cards, btn_prev, btn_next
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/l_windowBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="88dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Row: language label + spinner ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bliss_lang_label"
                    android:textStyle="bold"
                    android:textColor="@color/l_textColorPrimary"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/spinner_language"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/bliss_lang_label"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <!-- ── TextInputLayout + TextInputEditText ── -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_text"
                style="@style/inputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/bliss_hint_input"
                app:boxBackgroundMode="none"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_keyboard"
                app:endIconContentDescription="@string/bliss_cd_mode_auto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_input_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top"
                    android:textColor="@color/l_textColor"
                    android:contentDescription="@string/bliss_hint_input" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Suggestions label ── -->
            <TextView
                android:id="@+id/label_suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bliss_suggestions_label"
                android:textColor="@color/l_textColor"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ── Horizontal suggestions RecyclerView ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_suggestions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:listitem="@layout/item_suggestion" />

            <!-- ── Translate button + ProgressBar row ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_translate"
                    style="@style/filledButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/bliss_btn_translate"
                    android:contentDescription="@string/bliss_btn_translate"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progress_translate"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </FrameLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 BLOCCO C — Toggle modalità CAA
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bliss_caa_mode_label"
                    android:textColor="@color/l_textColorPrimary"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_caa_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/bliss_caa_mode_cd"
                    android:checked="false" />

            </LinearLayout>

            <!-- ── Output label (stats) ── -->
            <TextView
                android:id="@+id/text_output_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/l_textColor"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:accessibilityLiveRegion="polite" />

            <!-- ── Transliterated text output ── -->
            <TextView
                android:id="@+id/text_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/l_textColorPrimary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:accessibilityLiveRegion="polite"
                tools:text="parola simbolo …" />

            <!-- ── Modalità STANDARD: Symbol chips label + FlexboxLayout ── -->
            <TextView
                android:id="@+id/label_symbols"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bliss_symbols_label"
                android:textStyle="bold"
                android:textColor="@color/l_textColorPrimary"
                android:layout_marginBottom="8dp" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/symbol_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:flexWrap="wrap"
                app:alignItems="flex_start"
                app:alignContent="flex_start"
                android:accessibilityLiveRegion="polite"
                tools:ignore="UnusedAttribute" />

            <!-- ═══════════════════════════════════════════════════════════════
                 PATCH 12 — Riga mista testo+SVG in modalità standard multi-token
                 GONE di default; il Fragment la mostra via applyCaaVisibility()
                 quando CAA=false e la traduzione contiene più token.
                 ═══════════════════════════════════════════════════════════════ -->
            <com.blueapps.egyptianwriter.bliss.MixedBlissRowView
                android:id="@+id/mixed_bliss_row_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ═══════════════════════════════════════════════════════════════
                 BLOCCO C — Modalità CAA: card singole + navigazione
                 GONE di default; il Fragment lo mostra al toggle dello switch.
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/caa_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Card RecyclerView (non scrollabile internamente:
                     lo scroll è gestito dal NestedScrollView esterno) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_caa_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="8dp"
                    tools:listitem="@layout/item_symbol_card" />

                <!-- Row navigazione avanti/indietro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_prev"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/bliss_caa_prev"
                        android:contentDescription="@string/bliss_caa_prev_cd"
                        android:enabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_next"
                        style="@style/filledButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/bliss_caa_next"
                        android:contentDescription="@string/bliss_caa_next_cd"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── FAB Share SVG (anchored to bottom-end) ── -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/bliss_btn_share"
        android:contentDescription="@string/bliss_btn_share"
        app:icon="@android:drawable/ic_menu_share"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
