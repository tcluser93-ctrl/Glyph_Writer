<?xml version="1.0" encoding="utf-8"?>
<!--
    item_symbol_card.xml
    Card responsiva per la griglia simboli Bliss.

    Layout strategy:
      - MaterialCardView usa match_parent in larghezza (gestito da GridLayoutManager)
        e wrap_content in altezza → l'altezza della card segue automaticamente
        la larghezza assegnata dalla colonna.
      - Il contenitore del simbolo SVG è un ConstraintLayout con larghezza 0dp
        (= match_constraint) e dimensionRatio "1:1.5" → il blocco è alto il 50%
        in più della larghezza di colonna, per dare più respiro al simbolo SVG
        invece di uno stretto quadrato 1:1.
      - Margine card ridotto a 4dp e padding interno a 6dp per massimizzare
        lo spazio disponibile in colonne strette.
      - Testi ridotti (gloss 12sp, source_word 10sp) per non eccedere la larghezza.

    ## Fix (audit EG, 2026-07-22) — card nere/simboli invisibili, Material3 vero
    Base.Theme.EgyptianWriter (Theme.Material3.DayNight) non definiva mai
    colorSurface/colorOnSurface/colorSurfaceVariant/colorOnSurfaceVariant/
    colorOutline in nessuno dei due temi (chiaro/scuro). MaterialCardView non
    specificava app:cardBackgroundColor, quindi ereditava il colorSurface di
    default di Material3 — quasi nero in dark mode — mentre i testi interni
    restavano fissi scuri. Card nera con testo scuro-su-nero, contrasto quasi
    nullo: esattamente il bug segnalato.

    Fix reale (non un cerotto): i 5 ruoli Material3 mancanti sono ora definiti
    in values/themes.xml + values-night/themes.xml (vedi il commento su
    m3_colorSurface in values/colors.xml per il dettaglio completo), quindi
    qui si usano i veri attributi tema (?attr/colorSurface ecc.) — la card
    ora si adatta correttamente al tema chiaro/scuro di sistema, invece di
    colori fissi hardcoded.

    ECCEZIONE DELIBERATA: l'area di rendering del simbolo SVG
    (card_symbol_svg_image) NON segue il tema — usa @color/bliss_symbol_canvas,
    fisso e sempre chiaro. Motivo: ogni SVG Bliss ha tratti colore fisso
    (stroke nero, hardcoded nell'asset), senza alcuna consapevolezza del
    tema. Se questa superficie diventasse scura in dark mode, i tratti neri
    sparirebbero di nuovo — stesso bug, causa diversa. Vedi il commento su
    bliss_symbol_canvas in values/colors.xml per l'analisi completa. Un tint
    esplicito scuro (bliss_symbol_tint) è applicato al drawable in
    BlissSymbolCardAdapter per difesa in profondità, indipendente dal tema.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:gravity="center_horizontal">

        <!-- Contatore posizione (es. "2 / 5") -->
        <TextView
            android:id="@+id/card_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="9sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="2dp" />

        <!--
            E-01/E-03: SVG reale + spinner sovrapposti.

            ConstraintLayout con dimensionRatio="1:1.5" e larghezza 0dp:
              → il blocco è alto 1.5x la larghezza di colonna. fitCenter
                sull'ImageView garantisce che il simbolo SVG resti
                completamente visibile e proporzionato dentro il blocco.

            Il background dell'ImageView (bliss_symbol_canvas) NON segue il
            tema — vedi il commento in cima al file per il perché.

            Accessibility:
              ImageView – contentDescription gestita dinamicamente dall'adapter
                (loading / ready / missing state come da E-03).
              ProgressBar – importantForAccessibility=no, TalkBack salta lo spinner.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1.5"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/card_symbol_svg_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                android:layerType="software"
                android:background="@color/bliss_symbol_canvas"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/card_symbol_svg_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Gloss canonico BCI-AV -->
        <TextView
            android:id="@+id/card_gloss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <!-- Parola sorgente digitata dall'utente -->
        <TextView
            android:id="@+id/card_source_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Badge tipo di match: info tecnica, TalkBack la salta.
             textColor FISSO (bliss_chip_text), non theme-adaptive: lo sfondo
             del badge (impostato via matchColor() nell'adapter) è un
             pastello chiaro fisso indipendente dal tema — stesso approccio
             di CHIPS (chipColor()/bliss_chip_text). Usare ?attr/colorOnSurface
             qui sarebbe stato un secondo bug identico al primo: in dark mode
             risolverebbe a un colore chiaro (#F0E6D8) su sfondo pastello
             altrettanto chiaro — contrasto ~1:1, illeggibile. Verificato:
             bliss_chip_text su tutti gli 8 pastelli di matchColor() >= 9.5:1. -->
        <TextView
            android:id="@+id/card_match_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:textColor="@color/bliss_chip_text"
            android:importantForAccessibility="no" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
