<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/l_backgroundDark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Contatore posizione (es. "2 / 5") -->
        <TextView
            android:id="@+id/card_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="12sp"
            android:textColor="@color/l_textColor"
            android:layout_marginBottom="8dp" />

        <!--
            E-01/E-03: SVG reale + spinner sovrapposti.

            ImageView (card_symbol_svg_image)
              - layerType=software: obbligatorio per PictureDrawable (API < 28)
              - contentDescription: NON impostata qui, viene gestita dinamicamente
                dall'adapter in tre stati (E-03):
                  * caricamento  → bliss_caa_svg_loading
                  * SVG trovato  → bliss_caa_svg_ready  (%s = gloss)
                  * SVG mancante → bliss_caa_svg_missing (%s = bciAvId)

            ProgressBar (card_symbol_svg_progress)
              - importantForAccessibility=no: TalkBack salta lo spinner;
                l'utente è già informato dalla contentDescription dell'ImageView.

            tvMatchBadge
              - importantForAccessibility=no: info tecnica secondaria,
                non rilevante per la comunicazione aumentativa.
        -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/card_symbol_svg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:layerType="software"
                android:background="@color/l_backgroundDarker" />

            <ProgressBar
                android:id="@+id/card_symbol_svg_progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <!-- Gloss canonico BCI-AV -->
        <TextView
            android:id="@+id/card_gloss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/l_textColorPrimary"
            android:layout_marginBottom="8dp" />

        <!-- Parola sorgente digitata dall'utente -->
        <TextView
            android:id="@+id/card_source_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/l_textColor"
            android:layout_marginBottom="12dp" />

        <!-- Badge tipo di match: info tecnica, TalkBack la salta -->
        <TextView
            android:id="@+id/card_match_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textColor="@color/l_textColorPrimary"
            android:importantForAccessibility="no" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
