<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/l_backgroundDark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Contatore posizione (es. "2 / 5") -->
        <TextView
            android:id="@+id/card_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="12sp"
            android:textColor="@color/l_textColor"
            android:layout_marginBottom="8dp" />

        <!--
            E-01 — SVG reale al posto del rettangolo beige.
            FrameLayout sovrappone:
              • ImageView  → mostra il PictureDrawable BCI-AV
              • ProgressBar → visibile durante il caricamento async

            layerType=SOFTWARE è obbligatorio per PictureDrawable
            (android.graphics.Picture usa operazioni Canvas non supportate
            da hardware acceleration su API < 28).
        -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/card_symbol_svg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:layerType="software"
                android:contentDescription=""
                android:background="@color/l_backgroundDarker" />

            <ProgressBar
                android:id="@+id/card_symbol_svg_progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="visible" />

        </FrameLayout>

        <!-- Gloss canonico BCI-AV -->
        <TextView
            android:id="@+id/card_gloss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/l_textColorPrimary"
            android:layout_marginBottom="8dp" />

        <!-- Parola sorgente digitata dall'utente -->
        <TextView
            android:id="@+id/card_source_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/l_textColor"
            android:layout_marginBottom="12dp" />

        <!-- Badge tipo di match -->
        <TextView
            android:id="@+id/card_match_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:textColor="@color/l_textColorPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
