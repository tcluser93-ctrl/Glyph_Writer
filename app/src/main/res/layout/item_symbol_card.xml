<?xml version="1.0" encoding="utf-8"?>
<!--
    item_symbol_card.xml
    Card responsiva per la griglia simboli Bliss.

    Layout strategy:
      - MaterialCardView usa match_parent in larghezza (gestito da GridLayoutManager)
        e wrap_content in altezza → l'altezza della card segue automaticamente
        la larghezza assegnata dalla colonna.
      - Il contenitore del simbolo SVG è un ConstraintLayout con larghezza 0dp
        (= match_constraint) e dimensionRatio "1:1" → quadrato perfetto proporzionale
        alla colonna, qualunque sia lo spanCount (2, 3, 4…).
      - Margine card ridotto a 4dp e padding interno a 6dp per massimizzare
        lo spazio disponibile in colonne strette.
      - Testi ridotti (gloss 12sp, source_word 10sp) per non eccedere la larghezza.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/l_backgroundDark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:gravity="center_horizontal">

        <!-- Contatore posizione (es. "2 / 5") -->
        <TextView
            android:id="@+id/card_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="9sp"
            android:textColor="@color/l_textColor"
            android:layout_marginBottom="2dp" />

        <!--
            E-01/E-03: SVG reale + spinner sovrapposti.

            ConstraintLayout con dimensionRatio="1:1" e larghezza 0dp:
              → il blocco è sempre quadrato e scala con la larghezza della colonna.
              → fitCenter sull'ImageView garantisce che il simbolo SVG resti
                completamente visibile dentro il quadrato.

            Accessibility:
              ImageView – contentDescription gestita dinamicamente dall'adapter
                (loading / ready / missing state come da E-03).
              ProgressBar – importantForAccessibility=no, TalkBack salta lo spinner.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/card_symbol_svg_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                android:layerType="software"
                android:background="@color/l_backgroundDarker"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/card_symbol_svg_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Gloss canonico BCI-AV -->
        <TextView
            android:id="@+id/card_gloss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/l_textColorPrimary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <!-- Parola sorgente digitata dall'utente -->
        <TextView
            android:id="@+id/card_source_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="@color/l_textColor"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Badge tipo di match: info tecnica, TalkBack la salta -->
        <TextView
            android:id="@+id/card_match_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:textColor="@color/l_textColorPrimary"
            android:importantForAccessibility="no" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
