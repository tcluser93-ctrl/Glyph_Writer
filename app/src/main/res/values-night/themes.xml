<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (dark). -->
    <style name="Base.Theme.EgyptianWriter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/d_windowBackground</item>
        <item name="colorPrimary">@color/d_colorPrimary</item>
        <item name="colorPrimaryDark">@color/d_colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/d_textColorSecondary</item>
        <item name="android:textColorPrimary">@color/d_textColorPrimary</item>
        <item name="android:textColor">@color/d_textColor</item>
        <item name="android:colorBackground">@color/d_windowBackground</item>
        <!--
            Material3 color roles (audit EG, 2026-07-22) — see
            values/colors.xml's header comment on m3_colorSurface, and this
            file's counterpart in values/themes.xml. Styles with the same
            name in values/ vs values-night/ do NOT merge item-by-item — each
            is a complete, independent definition against its own `parent` —
            so these 5 items must be (and are) repeated here explicitly, not
            just added once in the light-mode file.
        -->
        <item name="colorSurface">@color/m3_colorSurface</item>
        <item name="colorOnSurface">@color/m3_colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/m3_colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3_colorOnSurfaceVariant</item>
        <item name="colorOutline">@color/m3_colorOutline</item>
    </style>

    <style name="popup_window_animation">
        <item name="android:windowEnterAnimation">@anim/popup_anim</item>
        <item name="android:windowExitAnimation">@anim/popdown_anim</item>
    </style>

    <style name="filledButton">
        <item name="android:background">@drawable/custom_button_filled</item>
        <item name="android:textColor">@color/d_textColorSecondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/d_textColorSecondary</item>
    </style>

    <style name="filledButtonWarning">
        <item name="android:background">@drawable/custom_button_filled_warning</item>
        <item name="android:textColor">@color/d_textColorSecondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/d_textColorSecondary</item>
    </style>

    <style name="borderedButton">
        <item name="android:background">@drawable/custom_button_bordered</item>
        <item name="android:textColor">@color/d_colorPrimaryDark</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/d_colorPrimaryDark</item>
    </style>

    <style name="borderedButtonWhite">
        <item name="android:background">@drawable/custom_button_bordered_white</item>
        <item name="android:textColor">@color/d_colorPrimaryDark</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/d_colorPrimaryDark</item>
    </style>

    <style name="textViewPrimary">
        <item name="android:textColor">@color/d_textColorPrimary</item>
    </style>

    <style name="textViewNormal">
        <item name="android:textColor">@color/d_textColor</item>
    </style>

    <style name="inputText">
        <item name="android:background">@drawable/custom_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/d_textColor</item>
        <item name="android:textColorHighlight">@color/d_colorPrimary</item>
    </style>

    <style name="errorText">
        <item name="android:textColor">@color/d_textColorError</item>
    </style>

    <style name="menu_item_normal">
        <item name="android:textColor">@color/d_textColorPrimary</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="drawableTint">@color/d_textColorPrimary</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_margin">1dp</item>
    </style>

    <style name="menu_item_warning">
        <item name="android:textColor">@color/d_textColorError</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="drawableTint">@color/d_textColorError</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_marginLeft">1dp</item>
        <item name="android:layout_marginRight">1dp</item>
    </style>

    <style name="menu_separator">
        <item name="android:background">@color/d_colorPrimary</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
    </style>

    <style name="scrollViewNormal">
        <item name="android:background">@color/d_windowBackground</item>
    </style>

    <style name="imageButtonFilled">
        <item name="android:background">@drawable/custom_button_filled</item>
        <item name="android:tint">@color/d_textColorSecondary</item>
    </style>

    <style name="imageBarItem">
        <item name="android:background">@drawable/image_bar_text</item>
        <item name="android:tint">@color/d_textColorPrimary</item>
    </style>

    <style name="imageButtonTitleBar">
        <item name="android:background">@drawable/custom_image_button_bg_title_bar</item>
        <item name="android:tint">@color/d_textColor</item>
    </style>

    <style name="imageButtonLight">
        <item name="android:background">@drawable/custom_image_button_bg</item>
        <item name="android:tint">@color/d_textColor</item>
    </style>

</resources>
